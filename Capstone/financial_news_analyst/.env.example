# === API Keys (Required) ===
OPENAI_API_KEY=your_openai_api_key_here

# === Finnhub API ===
# Get free key at https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key_here

# === Optional: News API ===
# Get free key at https://newsapi.org
NEWS_API_KEY=your_news_api_key_here

# === App Settings ===
APP_ENV=development
LOG_LEVEL=INFO

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=10

# === RAG Settings ===
QDRANT_PATH=./qdrant_db
TOP_K_RESULTS=4

# === History Settings ===
DB_PATH=./app.db

# === LLM Settings ===
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MAX_TOKENS=1024
TEMPERATURE=0.3

# === Auth ===
# Authentication is always required.
# Bootstrap creates/updates this account on API startup (password min 8 chars).
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=

# Allow anyone to register a new account (only when AUTH_ENABLED=true).
ALLOW_USER_REGISTRATION=true

# === CORS (comma-separated origins) ===
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501,http://127.0.0.1:8501

# === History minimization ===
# Store trimmed articles/market text in SQLite when false
STORE_FULL_STATE=true
MAX_ARTICLE_CHARS_STORED=800
# For POST /history/prune default when ?days= omitted (0 = require query param)
HISTORY_RETENTION_DAYS=0

# === RAG quality threshold (cosine similarity, higher = stronger match) ===
RAG_MIN_SIMILARITY=0.28

# === MCP result cache (seconds) ===
CACHE_TTL_SECONDS=120

# === Moderation (OpenAI Moderations API; skipped without OPENAI_API_KEY) ===
ENABLE_CONTENT_MODERATION=true

